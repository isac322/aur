# Maintainer: Byeonghoon Yoo <bhyoo at bhyoo dot com>

# Note: the license= field reflects upstream package.json's self-declaration of
#       "MIT". Upstream does not ship a LICENSE file in the repository, so no
#       license text is installed under /usr/share/licenses/. namcap will flag
#       "Uncommon license identifiers such as 'MIT' require license files" — this
#       is the intended state until upstream <https://github.com/rynfar/meridian/issues>
#       adds a canonical LICENSE file.

pkgname=meridian
pkgver=1.86.0
pkgrel=1
_commit=e521c5feb190d1b73b812b42bb51d1d068b3f11c
pkgdesc='Local Anthropic API powered by your Claude Max or Antigravity subscription'
arch=('x86_64' 'aarch64')
url='https://github.com/rynfar/meridian'
license=('MIT')
depends=('gcc-libs' 'glibc' 'nodejs>=22')
makedepends=('bun')
provides=('claude-max-proxy')
conflicts=('claude-max-proxy')
options=('!strip' '!debug')
install="${pkgname}.install"

source=(
  "${pkgname}-${pkgver}-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz"
  "${pkgname}.service"
)
sha256sums=('1bce248ca46ff13de003509845948883ed090ad9a6f5f66ea88e5fb91443ab4c'
            '214cb5117909c4c67be2e6f2a8031856a7bb05814093d0d39486027e11873b75')

build() {
  cd "${srcdir}/${pkgname}-${_commit}"
  export BUN_INSTALL_CACHE_DIR="${srcdir}/.bun-cache"
  bun install --frozen-lockfile --linker=hoisted
  bun run build

  # Upstream now builds with `--external libsql`, so bun no longer inlines
  # the libsql loader with frozen build-time paths.
  # Reinstall with production-only deps so the shipped node_modules tree is
  # free of devDependencies (bun2nix, typescript, @types/*, etc.). dist/ from
  # the build above is preserved.
  rm -rf node_modules
  bun install --production --frozen-lockfile --linker=hoisted
}

package() {
  cd "${srcdir}/${pkgname}-${_commit}"

  install -d "${pkgdir}/usr/lib/${pkgname}"
  # Preserve hardlinks that bun's hoisted linker creates between identical
  # vendor binaries (e.g. claude-code/bin/claude.exe and
  # claude-code-linux-x64/claude). This keeps each binary stored once in the
  # tarball, saving ~200 MB. namcap will flag a "Cross-directory hardlink in
  # package" E for this — that's a lint advisory; ALPM/pacman extracts
  # hardlinks correctly on every common filesystem (ext4/btrfs/xfs/zfs).
  cp -a dist node_modules plugin "${pkgdir}/usr/lib/${pkgname}/"
  install -Dm644 package.json "${pkgdir}/usr/lib/${pkgname}/package.json"

  # Drop musl-libc variant binaries — Arch is glibc-only and these are never
  # loaded here (saves ~100 MB compressed).
  find "${pkgdir}/usr/lib/${pkgname}/node_modules" -maxdepth 3 -type d \
    -name '*-musl*' -exec rm -rf {} +

  # bun install leaves files with mode 0666 (world-writable). Tighten so the
  # package matches Arch's expected permissions.
  chmod -R go-w "${pkgdir}/usr/lib/${pkgname}"

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${pkgname}" <<'WRAPPER'
#!/bin/sh
exec /usr/bin/node /usr/lib/meridian/dist/cli.js "$@"
WRAPPER

  ln -s "${pkgname}" "${pkgdir}/usr/bin/claude-max-proxy"

  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/user/${pkgname}.service"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
